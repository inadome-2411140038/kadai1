<h1>曲を編集</h1>

<%= form_with model: @song do |f| %>

  <p>
    <%= f.label :title, "曲名" %><br>
    <%= f.text_field :title %>
  </p>

  <p>
    <%= f.label :artist, "アーティスト" %><br>
    <%= f.text_field :artist %>
  </p>

  <p>
    <%= f.label :genre, "ジャンル" %><br>
    <%= f.text_field :genre %>
  </p>

  <p>
    <%= f.submit "更新" %>
  </p>

<% end %>

<%= link_to "一覧に戻る", songs_path %>