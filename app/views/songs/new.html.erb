<h1>曲を追加</h1>

<% if @song.errors.any? %>
  <div class="errors">
    <h3>入力内容を確認してください</h3>

    <ul>
      <% @song.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @song do |f| %>

  <p>
    <%= f.label :title, "曲名" %><br>
    <%= f.text_field :title %>
  </p>

  <p>
    <%= f.label :artist, "アーティスト" %><br>
    <%= f.text_field :artist %>
  </p>

  <p>
    <%= f.label :genre, "ジャンル" %><br>
    <%= f.text_field :genre %>
  </p>

  <p>
    <%= f.submit "登録" %>
  </p>

<% end %>

<%= link_to "一覧に戻る", songs_path %>